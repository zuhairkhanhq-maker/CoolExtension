NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@database:5432/bypass
# Use a pooler in transaction mode at scale. TLS certificate verification stays enabled.
DB_SSL=true
DB_POOL_MAX=10
PUBLIC_ORIGIN=https://billing.example.com
EXTENSION_IDS=replace_with_your_chrome_extension_id
TRUST_PROXY_HOPS=0
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_ANNUAL_PRICE_ID=
PADDLE_CLIENT_TOKEN=
PADDLE_RPM=180
# Hosted payment page approved in Paddle; normally PUBLIC_ORIGIN/checkout.
CHECKOUT_ORIGIN=https://billing.example.com
SIGNING_KEY_ID=2026-01
SIGNING_PRIVATE_JWK=
AUTH_HMAC_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bypass <accounts@example.com>
# Short grants bound refund/revocation delay; refresh clients every 15–30 minutes.
GRANT_SECONDS=3600
PAYMENT_GRACE_HOURS=72
MAX_STATE_AGE_HOURS=24
SESSION_DAYS=30
